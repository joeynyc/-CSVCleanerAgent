# Anthropic (only required when LLM-assisted column mapping is needed)
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Shopify Admin API (required only for `csvclean import`)
# Store is the *.myshopify.com subdomain, e.g. "acme-store"
SHOPIFY_STORE=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-01
